# Server settings
PORT=3000

# JWT
JWT_SECRET=replace_this_with_a_strong_secret
JWT_EXPIRES_IN=7d

# OTP
OTP_EXPIRES_MINUTES=5

# Email (Gmail SMTP: use app password or OAuth2 in production)
# If you do not set EMAIL_USER/EMAIL_PASS in development, the app will use an Ethereal test account
# and log a preview URL where you can view the email in the browser (no real email will be sent).
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Music Vibe" <no-reply@musicvibe.com>

# Support
SUPPORT_EMAIL=support@musicvibe.com

# Clerk (frontend publishable key - do NOT use your secret key here)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_aGVyb2ljLXVuaWNvcm4tMTEuY2xlcmsuYWNjb3VudHMuZGV2JA
